! =========================
! si.win - Wannier90 input for Silicon, 12x12x12 k-grid
! =========================
! Optimized for Silicon calculation Done by QE
! Based on band gap: 0.5264 eV
! VBM = 6.0460 eV, CBM = 6.5724 eV
! =========================
! =========================

num_bands        =   20
num_iter         =  100
dis_num_iter     =  100

iprint           =    2
num_dump_cycles  =   10
num_print_cycles =   10

length_unit      =  bohr

begin projections
!! Bond-centred s-orbitals
f=-0.125,-0.125,0.375:s
f=0.375,-0.125,-0.125:s
f=-0.125,0.375,-0.125:s
f=-0.125,-0.125,-0.125:s
!! Atom-centred sp3-orbitals
Si:sp3
end projections

write_hr = .true.

!! (2) Valence + conduction bands (optional)
 num_wann        =   8
 select_projections 5-12
 dis_froz_max    =   6.5
 dis_win_max     =  17.0

begin unit_cell_cart
 bohr
-5.13   0.00   5.13
 0.00   5.13   5.13
-5.13   5.13   0.00
end unit_cell_cart

begin atoms_frac
Si 0.000000  0.000000  0.000000
Si 0.250000  0.250000  0.250000
end atoms_frac


! Band structure interpolation
bands_plot = true
bands_num_points = 200
bands_plot_format = gnuplot

! k-point path for silicon (standard path)
begin kpoint_path
G 0.00 0.00 0.00  X 0.50 0.00 0.50
X 0.50 0.00 0.50  W 0.50 0.25 0.75
W 0.50 0.25 0.75  K 0.38 0.38 0.75
K 0.38 0.38 0.75  G 0.00 0.00 0.00
G 0.00 0.00 0.00  L 0.50 0.50 0.50
L 0.50 0.50 0.50  U 0.63 0.25 0.63
U 0.63 0.25 0.63  W 0.50 0.25 0.75
W 0.50 0.25 0.75  L 0.50 0.50 0.50
L 0.50 0.50 0.50  K 0.38 0.38 0.75
U 0.63 0.25 0.63  X 0.50 0.00 0.50
end kpoint_path

mp_grid= 12 12 12

begin kpoints
