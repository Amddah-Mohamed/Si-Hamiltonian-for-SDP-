&control
    calculation    = 'relax'
    prefix         = 'si'
    pseudo_dir      =  './pseudo/'
    outdir          =  './tmp/'
    forc_conv_thr  = 1.0d-4
    nstep          = 100           
    verbosity      = 'high'
    wf_collect     = .true.
    disk_io        = 'low'
/
&system
    ibrav          = 2
    celldm(1)      = 10.26
    nat            = 2
    ntyp           = 1
    ecutwfc        = 30.0
    ecutrho        = 240.0          
    nbnd           = 20
/
&electrons
    conv_thr       = 1.0d-8          
    mixing_mode    = 'plain'
    mixing_beta    = 0.4
    electron_maxstep = 100
/
&ions
    ion_dynamics   = 'bfgs'
    
/
ATOMIC_SPECIES
Si  28.085  Si.pz-vbc.UPF

ATOMIC_POSITIONS crystal
Si  0.00  0.00  0.00
Si  0.25  0.25  0.25

K_POINTS automatic
12 12 12 0 0 0
