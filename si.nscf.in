! ========================================================
! Non-self-consistent field (NSCF) calculation for bulk silicon
! Typically used for band structure or Wannier90 inputs
! ========================================================

&control
    calculation    = 'nscf'           ! NSCF: compute eigenvalues at a dense k-point grid using previous SCF density
    prefix         = 'si'             ! Prefix for output files
    pseudo_dir     = './pseudo/'      ! Directory containing pseudopotentials
    outdir         = './tmp/'         ! Directory for temporary files
    verbosity      = 'high'           ! Detailed output
    disk_io        = 'low'            ! Reduce disk usage during calculation
    wf_collect     = .true.           ! Collect wavefunctions for post-processing
/
&system
    ibrav          = 2                ! FCC cubic lattice
    celldm(1)      = 10.26            ! Lattice parameter in Bohr
    nat            = 2                ! Number of atoms in the unit cell
    ntyp           = 1                ! Number of atomic species
    ecutwfc        = 30.0             ! Plane-wave cutoff for wavefunctions (Ry)
    nbnd           = 20               ! Number of electronic bands
    occupations    = 'fixed'          ! Occupations are fixed (useful for NSCF)
    nosym          = .true.           ! Disable symmetry (needed for dense k-point grids)
    noinv          = .true.           ! Disable inversion symmetry
/
&electrons
    conv_thr       = 1.0d-8           ! Convergence threshold for diagonalization
    diagonalization = 'cg'            ! Conjugate gradient method
/
ATOMIC_SPECIES
Si  28.085  Si.pz-vbc.UPF           ! Atomic species, mass, pseudopotential

ATOMIC_POSITIONS crystal
Si   0.00   0.00   0.00              ! Fractional coordinates
Si   0.25   0.25   0.25

K_POINTS {crystal}      ! list of 12*12*12 k-points generated explicitely using a python script (named kpoints.py in this repo)
 1728                                   ! Number of k-points (dense grid) 
